<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Gopal Joshi Hospital | Hospital OS</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
font-family:Inter,Arial,sans-serif;
background:#f4f7fb;
color:#172033;
min-height:100vh
}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.top{
height:70px;
background:#075985;
color:white;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 25px;
position:sticky;
top:0;
z-index:20;
box-shadow:0 2px 10px #0002
}
.brand{
display:flex;
align-items:center;
gap:12px
}
.logo{
width:44px;
height:44px;
border-radius:12px;
background:white;
color:#075985;
display:grid;
place-items:center;
font-weight:900
}
.brand h1{font-size:19px}
.brand small{opacity:.8}
.menuBtn{
display:none;
background:none;
border:0;
color:white;
font-size:25px
}
.layout{display:flex;min-height:calc(100vh - 70px)}
.side{
width:245px;
background:#0f172a;
color:white;
padding:18px 12px;
flex-shrink:0
}
.side-title{
font-size:11px;
color:#94a3b8;
padding:14px 12px 7px;
text-transform:uppercase
}
.side button{
width:100%;
border:0;
background:transparent;
color:#dbeafe;
padding:11px 12px;
text-align:left;
border-radius:9px;
margin:2px 0
}
.side button:hover,.side button.active{
background:#1e40af;
color:white
}
.main{flex:1;padding:25px;overflow:hidden}
.hero{
background:linear-gradient(135deg,#075985,#0f766e);
color:white;
padding:25px;
border-radius:18px;
margin-bottom:20px
}
.hero h2{font-size:28px;margin-bottom:7px}
.hero p{opacity:.9}
.cards{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:14px;
margin-bottom:22px
}
.card{
background:white;
border:1px solid #e5eaf2;
border-radius:15px;
padding:18px;
box-shadow:0 3px 12px #00000008
}
.card .num{
font-size:28px;
font-weight:800;
margin-top:8px
}
.card small{color:#64748b}
.section{
background:white;
border:1px solid #e5eaf2;
border-radius:15px;
padding:20px;
margin-bottom:20px
}
.section h2{margin-bottom:15px}
.moduleGrid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:12px
}
.module{
border:1px solid #e2e8f0;
border-radius:12px;
padding:15px;
background:#fff;
transition:.15s
}
.module:hover{
transform:translateY(-2px);
box-shadow:0 5px 15px #0001
}
.module b{display:block;margin-bottom:5px}
.module span{font-size:12px;color:#64748b}
.module button{
margin-top:12px;
border:0;
background:#e0f2fe;
color:#075985;
padding:7px 10px;
border-radius:7px
}
.toolbar{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-bottom:15px
}
input,select,textarea{
border:1px solid #cbd5e1;
border-radius:8px;
padding:10px;
background:white
}
input{min-width:220px}
.btn{
border:0;
border-radius:8px;
padding:10px 15px;
background:#075985;
color:white
}
.btn.secondary{background:#64748b}
.btn.success{background:#15803d}
.btn.danger{background:#b91c1c}
table{
width:100%;
border-collapse:collapse
}
th,td{
padding:10px;
border-bottom:1px solid #e5e7eb;
text-align:left;
font-size:13px
}
th{background:#f8fafc}
.status{
padding:4px 8px;
border-radius:20px;
font-size:11px;
background:#dcfce7;
color:#166534
}
.hidden{display:none!important}
.loading{padding:20px;text-align:center;color:#64748b}
.toast{
position:fixed;
right:20px;
bottom:20px;
background:#0f172a;
color:white;
padding:13px 17px;
border-radius:10px;
display:none;
z-index:99
}
.login{
min-height:100vh;
display:grid;
place-items:center;
background:linear-gradient(135deg,#075985,#0f766e);
padding:20px
}
.loginBox{
background:white;
width:min(430px,100%);
border-radius:18px;
padding:30px;
box-shadow:0 15px 50px #0004
}
.loginBox h1{margin-bottom:5px}
.loginBox p{color:#64748b;margin-bottom:20px}
.loginBox input,.loginBox select{
width:100%;
margin-bottom:12px
}
.loginBox .btn{width:100%}
.apiState{
display:inline-flex;
align-items:center;
gap:7px;
font-size:12px
}
.dot{
width:8px;height:8px;border-radius:50%;
background:#22c55e
}
@media(max-width:1000px){
.cards{grid-template-columns:repeat(2,1fr)}
.moduleGrid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:700px){
.menuBtn{display:block}
.side{
position:fixed;
left:-260px;
top:70px;
bottom:0;
z-index:30;
transition:.2s
}
.side.open{left:0}
.main{padding:14px}
.cards{grid-template-columns:1fr 1fr}
.moduleGrid{grid-template-columns:1fr}
.top{padding:0 14px}
.hero h2{font-size:22px}
table{min-width:700px}
.section{overflow:auto}
}
</style>
</head>

<body>

<div id="loginScreen" class="login">
<div class="loginBox">
<h1>🏥 Gopal Joshi Hospital</h1>
<p>Hospital Operating System</p>

<select id="role">
<option value="admin">Hospital Admin</option>
<option value="doctor">Doctor</option>
<option value="reception">Reception</option>
<option value="nurse">Nurse</option>
<option value="laboratory">Laboratory</option>
<option value="pharmacy">Pharmacy</option>
<option value="beds">Beds / IPD</option>
<option value="ambulance">Ambulance</option>
<option value="manager">Manager</option>
<option value="patient">Patient</option>
</select>

<input id="username" placeholder="Username">
<input id="password" type="password" placeholder="Password">

<button class="btn" onclick="enterHospital()">Enter Hospital OS</button>

<p style="margin-top:15px;font-size:12px">
Local hospital workspace
</p>
</div>
</div>

<div id="app" class="hidden">

<header class="top">
<div class="brand">
<div class="logo">GJ</div>
<div>
<h1>Gopal Joshi Hospital</h1>
<small>Hospital Operating System</small>
</div>
</div>

<div class="apiState">
<span class="dot"></span>
<span id="connection">System Online</span>
</div>

<button class="menuBtn" onclick="toggleMenu()">☰</button>
</header>

<div class="layout">

<aside id="side" class="side">

<div class="side-title">Main</div>

<button class="active" onclick="showPage('dashboard',this)">
🏠 Command Center
</button>

<button onclick="showPage('patients',this)">
👤 Patients
</button>

<button onclick="showPage('appointments',this)">
📅 Appointments
</button>

<button onclick="showPage('consultation',this)">
🩺 Consultation
</button>

<div class="side-title">Clinical</div>

<button onclick="showPage('laboratory',this)">
🧪 Laboratory
</button>

<button onclick="showPage('pharmacy',this)">
💊 Pharmacy
</button>

<button onclick="showPage('ipd',this)">
🛏️ IPD / Beds
</button>

<button onclick="showPage('nursing',this)">
👩‍⚕️ Nursing
</button>

<button onclick="showPage('emergency',this)">
🚑 Emergency
</button>

<div class="side-title">Operations</div>

<button onclick="showPage('inventory',this)">
📦 Inventory
</button>

<button onclick="showPage('staff',this)">
👥 Staff / HR
</button>

<button onclick="showPage('blood',this)">
🩸 Blood Bank
</button>

<button onclick="showPage('insurance',this)">
🛡️ Insurance / TPA
</button>

<button onclick="showPage('accounts',this)">
₹ Accounts
</button>

<div class="side-title">Management</div>

<button onclick="showPage('reports',this)">
📊 Reports
</button>

<button onclick="showPage('modules',this)">
⚙️ Hospital Modules
</button>

<button onclick="showPage('audit',this)">
🔐 Audit Logs
</button>

<button onclick="logout()">
↪ Logout
</button>

</aside>

<main class="main">

<!-- DASHBOARD -->
<section id="dashboard" class="page">

<div class="hero">
<h2>Hospital Command Center</h2>
<p>
Real-time operational overview of Gopal Joshi Hospital.
</p>
</div>

<div class="cards" id="stats">
<div class="card"><small>Patients</small><div class="num" id="sPatients">0</div></div>
<div class="card"><small>Appointments</small><div class="num" id="sAppointments">0</div></div>
<div class="card"><small>Admissions</small><div class="num" id="sAdmissions">0</div></div>
<div class="card"><small>Beds</small><div class="num" id="sBeds">0</div></div>
<div class="card"><small>Emergencies</small><div class="num" id="sEmergencies">0</div></div>
<div class="card"><small>Staff</small><div class="num" id="sStaff">0</div></div>
<div class="card"><small>Inventory</small><div class="num" id="sInventory">0</div></div>
<div class="card"><small>Pending Claims</small><div class="num" id="sClaims">0</div></div>
</div>

<div class="section">
<h2>Hospital Workflow</h2>

<div class="moduleGrid">

<div class="module">
<b>Patient Registration</b>
<span>Register and manage patient records</span>
</div>

<div class="module">
<b>Appointment</b>
<span>Schedule and manage appointments</span>
</div>

<div class="module">
<b>Consultation</b>
<span>Doctor consultation and prescription</span>
</div>

<div class="module">
<b>Laboratory</b>
<span>Tests, samples and reports</span>
</div>

<div class="module">
<b>Pharmacy</b>
<span>Medicines, stock and dispensing</span>
</div>

<div class="module">
<b>Billing</b>
<span>Hospital bills and payments</span>
</div>

<div class="module">
<b>IPD</b>
<span>Admission, beds and discharge</span>
</div>

<div class="module">
<b>Emergency</b>
<span>Emergency and ambulance operations</span>
</div>

</div>
</div>

<div class="section">
<h2>Existing Hospital Panels</h2>

<div class="moduleGrid">

<a class="module" href="admin/index.html">
<b>🔐 Admin</b>
<span>Hospital administration</span>
</a>

<a class="module" href="doctor/index.html">
<b>🩺 Doctor</b>
<span>Doctor workspace</span>
</a>

<a class="module" href="patient/index.html">
<b>👤 Patient</b>
<span>Patient portal</span>
</a>

<a class="module" href="reception/index.html">
<b>🧾 Reception</b>
<span>Front desk</span>
</a>

<a class="module" href="laboratory/index.html">
<b>🧪 Laboratory</b>
<span>Lab management</span>
</a>

<a class="module" href="pharmacy/index.html">
<b>💊 Pharmacy</b>
<span>Pharmacy management</span>
</a>

<a class="module" href="nurse/index.html">
<b>👩‍⚕️ Nurse</b>
<span>Nursing workspace</span>
</a>

<a class="module" href="beds/index.html">
<b>🛏️ Beds</b>
<span>Bed management</span>
</a>

</div>
</div>

</section>

<!-- GENERIC MODULE PAGE -->
<section id="modulePage" class="page hidden">

<div class="section">

<h2 id="moduleTitle">Module</h2>

<div class="toolbar">
<input id="search" placeholder="Search records..." oninput="filterRows()">
<button class="btn" onclick="refreshModule()">Refresh</button>
<button class="btn success" onclick="newRecord()">+ Add Record</button>
</div>

<div id="moduleContent" class="loading">
Loading...
</div>

</div>

</section>

</main>
</div>
</div>

<div id="toast" class="toast"></div>

<script>

const API = "/api";
let currentModule = "";
let currentRecords = [];

const moduleMap = {

patients:"patients",
appointments:"appointments",
consultation:"procedures",
laboratory:"procedures",
pharmacy:"inventory",
ipd:"admissions",
nursing:"nursingTasks",
emergency:"emergencies",
inventory:"inventory",
staff:"staff",
blood:"bloodBank",
insurance:"insuranceClaims",
accounts:"accounts",
reports:"expenses",
modules:"departments",
audit:"auditLogs"

};

function toast(message){

const box=document.getElementById("toast");
box.textContent=message;
box.style.display="block";

setTimeout(()=>{
box.style.display="none";
},2500);

}

function toggleMenu(){

document.getElementById("side").classList.toggle("open");

}

function enterHospital(){

const role=document.getElementById("role").value;

localStorage.setItem("gjh_role",role);

document.getElementById("loginScreen").classList.add("hidden");
document.getElementById("app").classList.remove("hidden");

loadDashboard();

}

function logout(){

localStorage.removeItem("gjh_role");

location.reload();

}

async function api(url,options={}){

try{

const response=await fetch(url,options);

const data=await response.json();

if(!response.ok) throw new Error(data.message||"API error");

return data;

}catch(error){

console.error(error);
toast("Backend connection error");
throw error;

}

}

async function loadDashboard(){

try{

const result=await api(API+"/saas/os/command-center");

const d=result.dashboard||{};

document.getElementById("sAdmissions").textContent=d.admissions||0;
document.getElementById("sBeds").textContent=d.beds||0;
document.getElementById("sEmergencies").textContent=d.emergencies||0;
document.getElementById("sStaff").textContent=d.staff||0;
document.getElementById("sInventory").textContent=d.inventoryItems||0;
document.getElementById("sClaims").textContent=d.insuranceClaims||0;

}catch(e){}

try{

const patients=await api(API+"/saas/patients");
document.getElementById("sPatients").textContent=
patients.total ??
patients.patients?.length ??
patients.records?.length ??
0;

}catch(e){
document.getElementById("sPatients").textContent="0";
}

try{

const appointments=await api(API+"/appointments");
document.getElementById("sAppointments").textContent=
appointments.total ??
appointments.appointments?.length ??
appointments.records?.length ??
0;

}catch(e){
document.getElementById("sAppointments").textContent="0";
}

}

function showPage(page,button){

document.querySelectorAll(".page").forEach(x=>x.classList.add("hidden"));

if(page==="dashboard"){

document.getElementById("dashboard").classList.remove("hidden");
loadDashboard();

}else{

document.getElementById("modulePage").classList.remove("hidden");

currentModule=moduleMap[page]||page;

document.getElementById("moduleTitle").textContent=
page.charAt(0).toUpperCase()+page.slice(1);

refreshModule();

}

document.querySelectorAll(".side button").forEach(x=>x.classList.remove("active"));

if(button) button.classList.add("active");

document.getElementById("side").classList.remove("open");

}

async function refreshModule(){

if(!currentModule) return;

document.getElementById("moduleContent").innerHTML=
"<div class='loading'>Loading records...</div>";

try{

const result=await api(
API+"/saas/os/records/"+encodeURIComponent(currentModule)
);

currentRecords=result.records||[];

renderTable(currentRecords);

}catch(error){

document.getElementById("moduleContent").innerHTML=
"<div class='loading'>No records available yet.</div>";

}

}

function renderTable(records){

if(!records.length){

document.getElementById("moduleContent").innerHTML=
"<div class='loading'>No records found. Use + Add Record to create one.</div>";

return;

}

const keys=[...new Set(
records.flatMap(x=>Object.keys(x))
)].slice(0,7);

let html="<table><thead><tr>";

keys.forEach(k=>html+="<th>"+escapeHtml(k)+"</th>");

html+="</tr></thead><tbody>";

records.forEach(record=>{

html+="<tr>";

keys.forEach(k=>{

let value=record[k];

if(typeof value==="object")
value=JSON.stringify(value);

html+="<td>"+escapeHtml(value??"")+"</td>";

});

html+="</tr>";

});

html+="</tbody></table>";

document.getElementById("moduleContent").innerHTML=html;

}

function filterRows(){

const query=document.getElementById("search").value.toLowerCase();

renderTable(
currentRecords.filter(x=>
JSON.stringify(x).toLowerCase().includes(query)
)
);

}

async function newRecord(){

const name=prompt(
"Enter name/title for the new record:"
);

if(!name) return;

try{

await api(
API+"/saas/os/records/"+encodeURIComponent(currentModule),
{
method:"POST",
headers:{
"Content-Type":"application/json"
},
body:JSON.stringify({
name:name,
status:"Active"
})
}
);

toast("Record created successfully");

refreshModule();

}catch(error){}

}

async function loadModules(){

try{

const result=await api(API+"/saas/os/modules");

console.log(result);

}catch(e){}

}

function escapeHtml(value){

return String(value)
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}

async function checkServer(){

try{

await api(API+"/saas/os/health");

document.getElementById("connection").textContent=
"Backend Online";

}catch(e){

document.getElementById("connection").textContent=
"Backend Offline";

}

}

if(localStorage.getItem("gjh_role")){

document.getElementById("loginScreen").classList.add("hidden");
document.getElementById("app").classList.remove("hidden");

}

checkServer();
loadDashboard();
loadModules();

</script>

</body>
</html>
