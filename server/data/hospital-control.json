  "modules": [
    {"id":"dashboard","name":"Command Center","path":"/command-center/","icon":"◈","roles":["super_admin","hospital_admin","doctor","nurse","reception","laboratory","pharmacy","billing","hr","accounts"]},
    {"id":"patients","name":"Patient Management","path":"/hospital-admin/?module=patients","icon":"👤","roles":["super_admin","hospital_admin","doctor","nurse","reception","laboratory","pharmacy"]},
    {"id":"reception","name":"Reception","path":"/reception/","icon":"🧾","roles":["hospital_admin","reception"]},
    {"id":"doctor","name":"Doctor / Consultation","path":"/doctor/","icon":"🩺","roles":["hospital_admin","doctor"]},
    {"id":"nurse","name":"Nursing","path":"/nurse/","icon":"👩‍⚕️","roles":["hospital_admin","nurse"]},
    {"id":"laboratory","name":"Laboratory","path":"/laboratory/","icon":"🧪","roles":["hospital_admin","doctor","laboratory"]},
    {"id":"pharmacy","name":"Pharmacy","path":"/pharmacy/","icon":"💊","roles":["hospital_admin","doctor","pharmacy"]},
    {"id":"billing","name":"Billing","path":"/billing/","icon":"💳","roles":["hospital_admin","billing"]},
    {"id":"ipd","name":"IPD / Admission","path":"/ipd/","icon":"🛏","roles":["hospital_admin","doctor","nurse"]},
    {"id":"beds","name":"Beds & Wards","path":"/beds/","icon":"🛏","roles":["hospital_admin","nurse"]},
    {"id":"emergency","name":"Emergency","path":"/emergency/","icon":"🚨","roles":["hospital_admin","doctor","nurse"]},
    {"id":"ambulance","name":"Ambulance","path":"/ambulance/","icon":"🚑","roles":["hospital_admin"]},
    {"id":"ot","name":"OT / Surgery","path":"/ot-surgery/","icon":"🏥","roles":["hospital_admin","doctor","nurse"]},
    {"id":"blood","name":"Blood Bank","path":"/blood-bank/","icon":"🩸","roles":["hospital_admin"]},
    {"id":"inventory","name":"Inventory","path":"/inventory/","icon":"📦","roles":["hospital_admin","pharmacy"]},
    {"id":"suppliers","name":"Suppliers / Purchase","path":"/suppliers/","icon":"🚚","roles":["hospital_admin"]},
    {"id":"insurance","name":"Insurance / TPA","path":"/insurance/","icon":"📑","roles":["hospital_admin","billing"]},
    {"id":"hr","name":"HR / Staff","path":"/hr/","icon":"👥","roles":["super_admin","hospital_admin","hr"]},
    {"id":"accounts","name":"Accounts","path":"/accounts/","icon":"💰","roles":["super_admin","hospital_admin","accounts"]},
    {"id":"reports","name":"Reports & Analytics","path":"/reports/","icon":"📊","roles":["super_admin","hospital_admin","doctor","laboratory","accounts","hr"]},
    {"id":"audit","name":"Audit & Security","path":"/audit-security/","icon":"🔐","roles":["super_admin","hospital_admin"]}
  ],
  "auditLogs": [],
  "securityEvents": []
}
