        "dashboard.view",
        "patients.view",
        "patients.create",
        "patients.edit",
        "appointments.view",
        "appointments.create",
        "billing.view"
      ]
    },
    "laboratory": {
      "label": "Laboratory",
      "permissions": [
        "dashboard.view",
        "patients.view",
        "laboratory.view",
        "laboratory.create",
        "laboratory.update",
        "reports.view"
      ]
    },
    "pharmacy": {
      "label": "Pharmacy",
      "permissions": [
        "dashboard.view",
        "patients.view",
        "pharmacy.view",
        "pharmacy.create",
        "inventory.view",
        "inventory.update",
        "billing.view"
      ]
    },
