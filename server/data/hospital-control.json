    "accounts": {
      "label": "Accounts",
      "permissions": [
        "dashboard.view",
        "accounts.view",
        "accounts.create",
        "reports.view"
      ]
    },
    "patient": {
      "label": "Patient",
      "permissions": [
        "dashboard.view",
        "appointments.view",
        "appointments.create",
        "prescription.view",
        "laboratory.view",
        "billing.view"
      ]
    }
