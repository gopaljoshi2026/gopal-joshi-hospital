        "patients.view",
        "patients.create",
        "patients.edit",
        "appointments.view",
        "appointments.create",
        "consultation.view",
        "laboratory.view",
        "pharmacy.view",
        "billing.view",
        "ipd.view",
        "beds.view",
        "emergency.view",
        "ambulance.view",
        "ot.view",
        "blood.view",
        "inventory.view",
        "suppliers.view",
        "insurance.view",
        "hr.view",
        "accounts.view",
        "reports.view",
        "audit.view",
        "users.manage",
        "roles.manage",
        "settings.manage"
      ]
    },
    "doctor": {
      "label": "Doctor",
      "permissions": [
        "dashboard.view",
        "patients.view",
        "appointments.view",
        "consultation.view",
        "consultation.create",
        "prescription.create",
        "laboratory.create",
        "reports.view"
      ]
    },
    "nurse": {
      "label": "Nurse",
      "permissions": [
        "dashboard.view",
        "patients.view",
        "nursing.view",
        "nursing.create",
        "beds.view",
        "ipd.view",
        "emergency.view"
      ]
    },
    "reception": {
      "label": "Reception",
